# Line endings are LF, everywhere. See cmem/INDEX.md → "LINE ENDINGS" and
# cmem/best-practices.md §6 for why.
#
# `.gitattributes` makes git store and check out LF; this file makes the EDITOR
# write LF in the first place. Both are needed: git's rule cannot reach a file an
# editor saves with CRLF before it is ever staged, and an editor's rule cannot
# reach a clone made with a different `core.autocrlf`. Keep the two in agreement.

root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Zig's own formatter: 4 spaces, no tabs.
[*.zig]
indent_style = space
indent_size = 4

[*.{mjs,js,json,ts}]
indent_style = space
indent_size = 2

[*.{c,h}]
indent_style = space
indent_size = 4

# The text corpora are INPUT to the assembler and, through `pin`, to a SHA-256
# digest compared against the sibling runtime. Never let an editor normalise
# whitespace in them: a trimmed line would move a digest.
[*.{wat,wast}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
